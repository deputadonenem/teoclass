# ==============================================================================
# TeoClass — Template de Variáveis de Ambiente (.env.example)
# ==============================================================================
# ATENÇÃO: Nunca adicione valores reais de produção ou segredos neste arquivo.
# Copie este arquivo para .env.local e preencha as variáveis locais.
# ==============================================================================

# Domínios e Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=teoclass.com.br

# Supabase (Instância dedicada TeoClass)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto-teoclass.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-privada

# Alcântara Hub (Assinatura e Entitlements M2M)
HUB_API_URL=https://api.hub.alcantara.com.br
HUB_M2M_CLIENT_ID=seu-client-id-teoclass
HUB_M2M_CLIENT_SECRET=seu-client-secret-teoclass
HUB_WEBHOOK_SECRET=seu-segredo-de-webhook-hub

# OpenAI (Captação e Assistente Institucional)
OPENAI_API_KEY=sua-chave-api-openai
OPENAI_MODEL=gpt-4o-mini

# E-mail Institucional (Transacional)
RESEND_API_KEY=sua-chave-resend
EMAIL_FROM=TeoClass <nao-responder@teoclass.com.br>
